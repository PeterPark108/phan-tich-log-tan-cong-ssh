	partition fact_su_kien = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\PETTER\Desktop\python\du_an_phan_tich_log_tan_cong\powerbi\fact_su_kien.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed0 = Table.TransformColumnTypes(Promoted, {{"event_id", Int64.Type}, {"timestamp", type datetime}, {"ngay", type date}, {"gio", Int64.Type}, {"ip", type text}, {"username", type text}, {"event_type", type text}, {"session_id", type text}}, "en-US"),
				    Typed = Table.ReplaceValue(Typed0, "", null, Replacer.ReplaceValue, {"ip", "username", "event_type", "session_id"}),
				    AddKey = Table.AddColumn(Typed, "username_key", each if [username] = null or Text.Trim([username]) = "" then null else Text.Lower(Text.Trim([username])), type text)
				in
				    AddKey

