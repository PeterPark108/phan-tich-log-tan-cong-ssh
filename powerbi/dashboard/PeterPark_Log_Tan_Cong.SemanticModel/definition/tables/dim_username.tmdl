	partition dim_username = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\PETTER\Desktop\python\du_an_phan_tich_log_tan_cong\powerbi\dim_username.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed0 = Table.TransformColumnTypes(Promoted, {{"username", type text}, {"so_lan_thu", Int64.Type}, {"so_ip", Int64.Type}, {"nhom_user", type text}, {"do_dai", Int64.Type}}, "en-US"),
				    Typed = Table.ReplaceValue(Typed0, "", null, Replacer.ReplaceValue, {"username", "nhom_user"}),
				    AddKey = Table.AddColumn(Typed, "username_key", each if [username] = null or Text.Trim([username]) = "" then null else Text.Lower(Text.Trim([username])), type text),
				    Grouped = Table.Group(AddKey, {"username_key"}, {{"username", each [username]{0}, type text}, {"so_lan_thu", each List.Sum([so_lan_thu]), Int64.Type}, {"so_ip", each List.Sum([so_ip]), Int64.Type}, {"nhom_user", each [nhom_user]{0}, type text}, {"do_dai", each [do_dai]{0}, Int64.Type}}),
				    Ranked = Table.AddRankColumn(Grouped, "hang", {"so_lan_thu", Order.Descending}, [RankKind = RankKind.Ordinal])
				in
				    Ranked

